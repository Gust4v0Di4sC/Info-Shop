{
  "name": "info-shop-angular",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "ng": "ng",
    "predev": "node set.env",
    "prestart": "node set.env",
    "prestart:spa": "node set.env",
    "prestart:ssr:dev": "node set.env",
    "prestart:ssr": "node set.env",
    "prebuild:ssr:local": "node set.env",
    "preci:verify": "node set.env",
    "start": "npm run dev",
    "dev": "ng serve --configuration local --host 127.0.0.1 --port 4200",
    "dev:netlify": "netlify dev --context dev",
    "start:client": "npm run dev",
    "start:spa": "ng serve --configuration development --host 127.0.0.1 --port 4200",
    "start:ssr:dev": "ng build --configuration development,local && node dist/info-shop-angular/server/server.mjs",
    "start:ssr": "ng build --configuration production,local && node dist/info-shop-angular/server/server.mjs",
    "build:ssr:local": "ng build --configuration development,local",
    "prebuild": "node set.env",
    "build": "ng build --configuration production",
    "build:observability": "npm run build && npm run sentry:sourcemaps",
    "netlify:build": "netlify build",
    "netlify:dev": "netlify dev",
    "typecheck:netlify": "tsc --project tsconfig.netlify.json",
    "ci:verify": "npm run typecheck:netlify && npm run build:ssr:local && npm run build",
    "ci:smoke:local": "node scripts/smoke-local-ssr.js",
    "e2e:public": "playwright test e2e/public.spec.ts e2e/public-mobile.spec.ts",
    "sentry:sourcemaps": "node scripts/upload-sentry-sourcemaps.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:types:local": "supabase gen types typescript --local > src/app/core/supabase/database.types.ts",
    "supabase:types:linked": "supabase gen types typescript --linked > src/app/core/supabase/database.types.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.28",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.28",
    "@angular/compiler": "20.3.28",
    "@angular/core": "20.3.28",
    "@angular/forms": "20.3.28",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.28",
    "@angular/platform-browser-dynamic": "20.3.28",
    "@angular/platform-server": "20.3.28",
    "@angular/router": "20.3.28",
    "@angular/service-worker": "^20.3.28",
    "@angular/ssr": "20.3.34",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@sentry/angular": "^10.70.0",
    "@sentry/cli": "^3.6.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "bootstrap": "^5.3.5",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "express": "5.2.1",
    "gsap": "^3.15.0",
    "material-icons": "^1.13.14",
    "ng2-charts": "^9.0.0",
    "path": "^0.12.7",
    "rxjs": "~7.8.0",
    "serverless-http": "^4.0.0",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.34",
    "@angular/build": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.28",
    "@netlify/angular-runtime": "^4.0.0",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "netlify-cli": "^27.3.0",
    "supabase": "^2.111.0",
    "typescript": "~5.9.2",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
