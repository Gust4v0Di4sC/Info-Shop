{
  "name": "info-shop-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node set.env",
    "start": "ng serve",
    "prebuild": "node set.env",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:types:local": "supabase gen types typescript --local > src/app/core/supabase/database.types.ts",
    "supabase:types:linked": "supabase gen types typescript --linked > src/app/core/supabase/database.types.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.2.2",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.2",
    "@angular/compiler": "^20.2.2",
    "@angular/core": "^20.2.2",
    "@angular/forms": "^20.2.2",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "^20.2.2",
    "@angular/platform-browser-dynamic": "^20.2.2",
    "@angular/router": "^20.2.2",
    "@angular/ssr": "^20.2.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@supabase/supabase-js": "^2.55.0",
    "bootstrap": "^5.3.5",
    "path": "^0.12.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.1",
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "supabase": "^2.111.0",
    "typescript": "~5.9.2",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
