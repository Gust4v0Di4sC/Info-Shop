const { existsSync, readFileSync, writeFileSync } = require('fs');
const { join } = require('path');

const root = __dirname;
const envLocalPath = join(root, '.env.local');
const envDevelopmentPath = join(root, '.env.development.local');
const envProductionPath = join(root, '.env.production.local');
const developmentTargetPath = join(root, './src/environments/environment.ts');
const productionTargetPath = join(root, './src/environments/environment.prod.ts');

function parseEnvFile(filePath) {
  if (!existsSync(filePath)) {
    return {};
  }

  return readFileSync(filePath, 'utf-8')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter((line) => line && !line.startsWith('#'))
    .reduce((env, line) => {
      const separatorIndex = line.indexOf('=');

      if (separatorIndex === -1) {
        return env;
      }

      const key = line.slice(0, separatorIndex).trim();
      const rawValue = line.slice(separatorIndex + 1).trim();
      env[key] = rawValue.replace(/^['"]|['"]$/g, '');
      return env;
    }, {});
}

function firstValue(...values) {
  return values.find(value => typeof value === 'string' && value.trim()) || '';
}

function toTsString(value) {
  return JSON.stringify(value || '');
}

function toTsNumber(value, fallback) {
  const parsed = Number(value);
  return Number.isFinite(parsed) && parsed >= 0 ? parsed : fallback;
}

const sharedLocalEnv = parseEnvFile(envLocalPath);
const developmentLocalEnv = parseEnvFile(envDevelopmentPath);
const productionLocalEnv = parseEnvFile(envProductionPath);

function publicEnvironment(target) {
  const targetEnv = target === 'production' ? productionLocalEnv : developmentLocalEnv;
  const targetPrefix = target === 'production' ? 'PROD_' : 'DEV_';
  const localPrefix = target === 'production' ? 'PRODUCTION_' : 'LOCAL_';
  const browserSentryEnabled =
    firstValue(
      process.env[`${targetPrefix}ENABLE_BROWSER_SENTRY`],
      process.env[`${localPrefix}ENABLE_BROWSER_SENTRY`],
      targetEnv.ENABLE_BROWSER_SENTRY,
      process.env.ENABLE_BROWSER_SENTRY,
      sharedLocalEnv.ENABLE_BROWSER_SENTRY,
    ) === 'true';
  const supabaseUrl = firstValue(
    process.env[`${targetPrefix}SUPABASE_URL`],
    process.env[`${localPrefix}SUPABASE_URL`],
    targetEnv.SUPABASE_URL,
    targetEnv.SUPABASE_LOCAL_URL,
    process.env.SUPABASE_URL,
    sharedLocalEnv.SUPABASE_URL,
    sharedLocalEnv.SUPABASE_LOCAL_URL,
  );
  const supabaseAnonKey = firstValue(
    process.env[`${targetPrefix}SUPABASE_ANON_KEY`],
    process.env[`${targetPrefix}SUPABASE_KEY`],
    process.env[`${localPrefix}SUPABASE_ANON_KEY`],
    process.env[`${localPrefix}SUPABASE_KEY`],
    targetEnv.SUPABASE_ANON_KEY,
    targetEnv.SUPABASE_KEY,
    targetEnv.SUPABASE_LOCAL_ANON_KEY,
    targetEnv.SUPABASE_LOCAL_KEY,
    process.env.SUPABASE_ANON_KEY,
    process.env.SUPABASE_KEY,
    sharedLocalEnv.SUPABASE_ANON_KEY,
    sharedLocalEnv.SUPABASE_KEY,
    sharedLocalEnv.SUPABASE_LOCAL_ANON_KEY,
    sharedLocalEnv.SUPABASE_LOCAL_KEY,
  );
  const sentryDsn = browserSentryEnabled
    ? firstValue(
        process.env[`${targetPrefix}SENTRY_DSN`],
        process.env[`${localPrefix}SENTRY_DSN`],
        targetEnv.SENTRY_DSN,
        process.env.SENTRY_DSN,
        sharedLocalEnv.SENTRY_DSN,
      )
    : '';
  const sentryEnvironment = firstValue(
    process.env[`${targetPrefix}SENTRY_ENVIRONMENT`],
    process.env[`${localPrefix}SENTRY_ENVIRONMENT`],
    targetEnv.SENTRY_ENVIRONMENT,
    process.env.SENTRY_ENVIRONMENT,
    process.env.CONTEXT,
    sharedLocalEnv.SENTRY_ENVIRONMENT,
    sharedLocalEnv.CONTEXT,
    target === 'production' ? 'production' : 'development',
  );
  const sentryRelease = firstValue(
    process.env[`${targetPrefix}SENTRY_RELEASE`],
    process.env[`${localPrefix}SENTRY_RELEASE`],
    targetEnv.SENTRY_RELEASE,
    process.env.SENTRY_RELEASE,
    process.env.COMMIT_REF,
    process.env.REVIEW_ID,
    sharedLocalEnv.SENTRY_RELEASE,
    sharedLocalEnv.COMMIT_REF,
    sharedLocalEnv.REVIEW_ID,
  );
  const sentryTracesSampleRate = toTsNumber(
    firstValue(
      process.env[`${targetPrefix}SENTRY_TRACES_SAMPLE_RATE`],
      process.env[`${localPrefix}SENTRY_TRACES_SAMPLE_RATE`],
      targetEnv.SENTRY_TRACES_SAMPLE_RATE,
      process.env.SENTRY_TRACES_SAMPLE_RATE,
      sharedLocalEnv.SENTRY_TRACES_SAMPLE_RATE,
    ),
    sentryDsn && target === 'production' ? 0.2 : 0,
  );
  const sentryReplaysSessionSampleRate = toTsNumber(
    firstValue(
      process.env[`${targetPrefix}SENTRY_REPLAYS_SESSION_SAMPLE_RATE`],
      process.env[`${localPrefix}SENTRY_REPLAYS_SESSION_SAMPLE_RATE`],
      targetEnv.SENTRY_REPLAYS_SESSION_SAMPLE_RATE,
      process.env.SENTRY_REPLAYS_SESSION_SAMPLE_RATE,
      sharedLocalEnv.SENTRY_REPLAYS_SESSION_SAMPLE_RATE,
    ),
    sentryDsn && target === 'production' ? 0.05 : 0,
  );
  const sentryReplaysOnErrorSampleRate = toTsNumber(
    firstValue(
      process.env[`${targetPrefix}SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE`],
      process.env[`${localPrefix}SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE`],
      targetEnv.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE,
      process.env.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE,
      sharedLocalEnv.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE,
    ),
    sentryDsn && target === 'production' ? 1 : 0,
  );

  return {
    production: target === 'production',
    supabaseUrl,
    supabaseAnonKey,
    sentryDsn,
    sentryEnvironment,
    sentryRelease,
    sentryTracesSampleRate,
    sentryReplaysSessionSampleRate,
    sentryReplaysOnErrorSampleRate,
  };
}

function renderEnvironment(config) {
  return `export const environment = {
  production: ${config.production},
  supabaseUrl: ${toTsString(config.supabaseUrl)},
  supabaseAnonKey: ${toTsString(config.supabaseAnonKey)},
  sentryDsn: ${toTsString(config.sentryDsn)},
  sentryEnvironment: ${toTsString(config.sentryEnvironment)},
  sentryRelease: ${toTsString(config.sentryRelease)},
  sentryTracesSampleRate: ${config.sentryTracesSampleRate},
  sentryReplaysSessionSampleRate: ${config.sentryReplaysSessionSampleRate},
  sentryReplaysOnErrorSampleRate: ${config.sentryReplaysOnErrorSampleRate}
};
`;
}

const developmentEnvironment = publicEnvironment('development');
const productionEnvironment = publicEnvironment('production');

if (
  process.env.SUPABASE_SERVICE_ROLE_KEY ||
  sharedLocalEnv.SUPABASE_SERVICE_ROLE_KEY ||
  developmentLocalEnv.SUPABASE_SERVICE_ROLE_KEY ||
  productionLocalEnv.SUPABASE_SERVICE_ROLE_KEY
) {
  console.warn(
    'SUPABASE_SERVICE_ROLE_KEY is intentionally ignored by the Angular build. Configure it only as a server or Supabase Edge Function secret.',
  );
}

writeFileSync(developmentTargetPath, renderEnvironment(developmentEnvironment), { encoding: 'utf-8' });
writeFileSync(productionTargetPath, renderEnvironment(productionEnvironment), { encoding: 'utf-8' });

if (!developmentEnvironment.supabaseUrl || !developmentEnvironment.supabaseAnonKey) {
  console.warn(
    'Development Supabase env vars not found. Add SUPABASE_URL and SUPABASE_ANON_KEY to .env.development.local or .env.local.',
  );
}

if (!productionEnvironment.supabaseUrl || !productionEnvironment.supabaseAnonKey) {
  console.warn(
    'Production Supabase env vars not found. Configure SUPABASE_URL and SUPABASE_ANON_KEY in Netlify or .env.production.local for local production checks.',
  );
}

console.log(`Environment files generated at ${developmentTargetPath} and ${productionTargetPath}.`);
