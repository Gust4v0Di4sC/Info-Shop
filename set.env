const { existsSync, readFileSync, writeFileSync } = require('fs');
const { join } = require('path');

const envLocalPath = join(__dirname, '.env.local');
const developmentTargetPath = join(__dirname, './src/environments/environment.ts');
const productionTargetPath = join(__dirname, './src/environments/environment.prod.ts');

function parseEnvFile(filePath) {
  if (!existsSync(filePath)) {
    return {};
  }

  return readFileSync(filePath, 'utf-8')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter((line) => line && !line.startsWith('#'))
    .reduce((env, line) => {
      const separatorIndex = line.indexOf('=');

      if (separatorIndex === -1) {
        return env;
      }

      const key = line.slice(0, separatorIndex).trim();
      const rawValue = line.slice(separatorIndex + 1).trim();
      env[key] = rawValue.replace(/^['"]|['"]$/g, '');
      return env;
    }, {});
}

function toTsString(value) {
  return JSON.stringify(value || '');
}

function toTsNumber(value, fallback) {
  const parsed = Number(value);
  return Number.isFinite(parsed) && parsed >= 0 ? parsed : fallback;
}

const localEnv = parseEnvFile(envLocalPath);
const browserSentryEnabled =
  process.env.ENABLE_BROWSER_SENTRY === 'true' ||
  localEnv.ENABLE_BROWSER_SENTRY === 'true';
const supabaseUrl = process.env.SUPABASE_URL || localEnv.SUPABASE_URL || '';
const supabaseAnonKey =
  process.env.SUPABASE_ANON_KEY ||
  process.env.SUPABASE_KEY ||
  localEnv.SUPABASE_ANON_KEY ||
  localEnv.SUPABASE_KEY ||
  '';
const sentryDsn = browserSentryEnabled
  ? process.env.SENTRY_DSN || localEnv.SENTRY_DSN || ''
  : '';
const sentryEnvironment =
  process.env.SENTRY_ENVIRONMENT ||
  process.env.CONTEXT ||
  localEnv.SENTRY_ENVIRONMENT ||
  localEnv.CONTEXT ||
  'production';
const sentryRelease =
  process.env.SENTRY_RELEASE ||
  process.env.COMMIT_REF ||
  process.env.REVIEW_ID ||
  localEnv.SENTRY_RELEASE ||
  localEnv.COMMIT_REF ||
  localEnv.REVIEW_ID ||
  '';
const sentryTracesSampleRate = toTsNumber(
  process.env.SENTRY_TRACES_SAMPLE_RATE || localEnv.SENTRY_TRACES_SAMPLE_RATE,
  sentryDsn ? 0.2 : 0,
);
const sentryReplaysSessionSampleRate = toTsNumber(
  process.env.SENTRY_REPLAYS_SESSION_SAMPLE_RATE || localEnv.SENTRY_REPLAYS_SESSION_SAMPLE_RATE,
  sentryDsn ? 0.05 : 0,
);
const sentryReplaysOnErrorSampleRate = toTsNumber(
  process.env.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE || localEnv.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE,
  sentryDsn ? 1 : 0,
);

if (process.env.SUPABASE_SERVICE_ROLE_KEY || localEnv.SUPABASE_SERVICE_ROLE_KEY) {
  console.warn(
    'SUPABASE_SERVICE_ROLE_KEY is intentionally ignored by the Angular build. Configure it only as a Supabase Edge Function secret.',
  );
}

const developmentEnvironmentFileContent = `export const environment = {
  production: false,
  supabaseUrl: ${toTsString(supabaseUrl)},
  supabaseAnonKey: ${toTsString(supabaseAnonKey)},
  sentryDsn: ${toTsString(sentryDsn)},
  sentryEnvironment: ${toTsString(localEnv.SENTRY_ENVIRONMENT || 'development')},
  sentryRelease: ${toTsString(localEnv.SENTRY_RELEASE)},
  sentryTracesSampleRate: ${toTsNumber(localEnv.SENTRY_TRACES_SAMPLE_RATE, 0)},
  sentryReplaysSessionSampleRate: ${toTsNumber(localEnv.SENTRY_REPLAYS_SESSION_SAMPLE_RATE, 0)},
  sentryReplaysOnErrorSampleRate: ${toTsNumber(localEnv.SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE, 0)}
};
`;

const productionEnvironmentFileContent = `export const environment = {
  production: true,
  supabaseUrl: ${toTsString(supabaseUrl)},
  supabaseAnonKey: ${toTsString(supabaseAnonKey)},
  sentryDsn: ${toTsString(sentryDsn)},
  sentryEnvironment: ${toTsString(sentryEnvironment)},
  sentryRelease: ${toTsString(sentryRelease)},
  sentryTracesSampleRate: ${sentryTracesSampleRate},
  sentryReplaysSessionSampleRate: ${sentryReplaysSessionSampleRate},
  sentryReplaysOnErrorSampleRate: ${sentryReplaysOnErrorSampleRate}
};
`;

writeFileSync(developmentTargetPath, developmentEnvironmentFileContent, { encoding: 'utf-8' });
writeFileSync(productionTargetPath, productionEnvironmentFileContent, { encoding: 'utf-8' });

if (!supabaseUrl || !supabaseAnonKey) {
  console.warn(
    'Supabase env vars not found. Add SUPABASE_URL and SUPABASE_ANON_KEY (or SUPABASE_KEY) to .env.local, your shell environment, or Netlify environment variables.',
  );
}

console.log(`Environment files generated at ${developmentTargetPath} and ${productionTargetPath}.`);
