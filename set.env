const { existsSync, readFileSync, writeFileSync } = require('fs');
const { join } = require('path');

const envLocalPath = join(__dirname, '.env.local');
const targetPath = join(__dirname, './src/environments/environment.prod.ts');

function parseEnvFile(filePath) {
  if (!existsSync(filePath)) {
    return {};
  }

  return readFileSync(filePath, 'utf-8')
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter((line) => line && !line.startsWith('#'))
    .reduce((env, line) => {
      const separatorIndex = line.indexOf('=');

      if (separatorIndex === -1) {
        return env;
      }

      const key = line.slice(0, separatorIndex).trim();
      const rawValue = line.slice(separatorIndex + 1).trim();
      env[key] = rawValue.replace(/^['"]|['"]$/g, '');
      return env;
    }, {});
}

function toTsString(value) {
  return JSON.stringify(value || '');
}

const localEnv = parseEnvFile(envLocalPath);
const supabaseUrl = process.env.SUPABASE_URL || localEnv.SUPABASE_URL || '';
const supabaseAnonKey =
  process.env.SUPABASE_ANON_KEY ||
  process.env.SUPABASE_KEY ||
  localEnv.SUPABASE_ANON_KEY ||
  localEnv.SUPABASE_KEY ||
  '';

if (process.env.SUPABASE_SERVICE_ROLE_KEY || localEnv.SUPABASE_SERVICE_ROLE_KEY) {
  console.warn(
    'SUPABASE_SERVICE_ROLE_KEY is intentionally ignored by the Angular build. Configure it only as a Supabase Edge Function secret.',
  );
}

const environmentFileContent = `export const environment = {
  production: true,
  supabaseUrl: ${toTsString(supabaseUrl)},
  supabaseAnonKey: ${toTsString(supabaseAnonKey)}
};
`;

writeFileSync(targetPath, environmentFileContent, { encoding: 'utf-8' });

if (!supabaseUrl || !supabaseAnonKey) {
  console.warn(
    'Supabase env vars not found. Add SUPABASE_URL and SUPABASE_ANON_KEY (or SUPABASE_KEY) to .env.local, your shell environment, or Netlify environment variables.',
  );
}

console.log(`Environment file generated at ${targetPath}.`);
